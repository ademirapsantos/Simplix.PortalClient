@{
    ViewData["Title"] = "Solicitacao registrada";
    string? resetLink = ViewBag.ResetLink as string;
    bool resetFlowDisabled = ViewBag.ResetFlowDisabled == true;
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Seguranca de acesso</span>
        <h1>Solicitacao registrada</h1>
        @if (resetFlowDisabled)
        {
            <p class="hero-description">O reset de senha esta desabilitado neste ambiente. Habilite a configuracao `PasswordReset` antes de usar o fluxo.</p>
        }
        else
        {
            <p class="hero-description">Se a conta existir e estiver ativa, um link temporario foi gerado com validade limitada e registrado no canal operacional configurado.</p>
        }

        @if (!string.IsNullOrWhiteSpace(resetLink))
        {
            <div class="alert alert-warning">
                <strong>Modo desenvolvimento:</strong> <a href="@resetLink">@resetLink</a>
            </div>
        }

        <a asp-action="Login" class="btn btn-primary">Voltar ao login</a>
    </div>
</section>
