@model Simplix.PortalClient.Application.Contracts.Portal.StorePageViewModel
@{
    ViewData["Title"] = "Simplix Store";
    ViewData["ShellMode"] = "public";
}

<section class="landing-hero">
    <div class="hero-copy hero-copy-main">
        <span class="eyebrow">Portal publico + Store</span>
        <h1>@Model.Title</h1>
        <p class="hero-description hero-description-strong">@Model.Subtitle</p>
        <div class="hero-actions">
            <button type="button" class="btn btn-primary btn-lg" data-bs-toggle="modal" data-bs-target="#storeCommercialModal">
                Quero falar com vendas
            </button>
            <a class="btn btn-outline-light btn-lg" asp-action="Index">Voltar ao portal</a>
        </div>
        <div class="hero-signal-grid">
            @foreach (var highlight in Model.ValueHighlights)
            {
                <article class="signal-card">
                    <span class="signal-icon"></span>
                    <p>@highlight</p>
                </article>
            }
        </div>
    </div>

    <aside class="hero-showcase">
        <div class="hero-showcase-card hero-showcase-primary">
            <span class="tag">Portfolio</span>
            <h2>Catalogo pensado para conversa comercial</h2>
            <p>Apresente aplicativos, posicionamento, status comercial e o proximo passo para cada interesse recebido pela startup.</p>
        </div>
        <div class="hero-showcase-stack">
            <article class="hero-showcase-card">
                <span class="showcase-label">Publico</span>
                <strong>Descoberta sem login</strong>
                <p>O visitante conhece o portfolio e entende rapidamente o valor da operacao.</p>
            </article>
            <article class="hero-showcase-card">
                <span class="showcase-label">Comercial</span>
                <strong>Lead capturado</strong>
                <p>O interesse chega pronto para virar atendimento de vendas e implantacao.</p>
            </article>
        </div>
    </aside>
</section>

<section class="section-block">
    <div class="section-heading">
        <div>
            <span class="section-kicker">Catalogo</span>
            <h2>Aplicativos apresentados com foco de venda</h2>
        </div>
        <span>@Model.Applications.Count aplicativo(s)</span>
    </div>
    <div class="card-grid">
        @foreach (var application in Model.Applications)
        {
            <article class="product-card product-card-featured">
                <span class="product-badge">@application.Category</span>
                <h2>@application.Name</h2>
                <p>@application.Description</p>
                <div class="card-footer card-footer-column">
                    <span>@application.Positioning</span>
                    <strong>@application.Status</strong>
                </div>
            </article>
        }
    </div>
</section>

<div class="modal fade" id="storeCommercialModal" tabindex="-1" aria-labelledby="storeCommercialModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content store-modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="storeCommercialModalLabel">Como voce quer seguir?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body store-modal-body">
                <p>Escolha o canal para falar com a Simplix agora.</p>
                <a class="btn btn-primary btn-lg" asp-action="CommercialInterest">Enviar interesse comercial</a>
                <a class="btn btn-outline-primary btn-lg" asp-action="StoreChat">Falar no chat</a>
            </div>
        </div>
    </div>
</div>
