@model KMKKM.PortalClient.Web.Models.Account.ResetPasswordViewModel
@{
    ViewData["Title"] = "Nova senha";
}

<section class="auth-shell">
    <div class="auth-card">
        <div>
            <span class="eyebrow">Seguranca de acesso</span>
            <h1>Definir nova senha</h1>
            <p class="hero-description">Use uma senha forte com pelo menos 12 caracteres, letras maiusculas e minusculas, numero e simbolo.</p>
        </div>

        <form method="post" class="auth-form">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />
            <input asp-for="Token" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div>
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg">Salvar nova senha</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
