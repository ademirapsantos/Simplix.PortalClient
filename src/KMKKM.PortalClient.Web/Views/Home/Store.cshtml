@model KMKKM.PortalClient.Application.Contracts.Portal.StorePageViewModel
@{
    ViewData["Title"] = "K.M.K.K.M Store";
}

<section class="dashboard-hero">
    <div>
        <span class="eyebrow">Catalogo institucional</span>
        <h1>@Model.Title</h1>
        <p class="hero-description">@Model.Subtitle</p>
    </div>
    <a class="btn btn-primary" asp-action="Index">Voltar ao portal</a>
</section>

<section class="card-grid">
    @foreach (var application in Model.Applications)
    {
        <article class="product-card">
            <span class="product-badge">@application.Category</span>
            <h2>@application.Name</h2>
            <p>@application.Description</p>
            <div class="card-footer">
                <span>@application.Positioning</span>
                <span>@application.Status</span>
            </div>
        </article>
    }
</section>
