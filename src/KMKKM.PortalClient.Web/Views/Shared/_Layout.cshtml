<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - K.M.K.K.M</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <div class="container-fluid shell-width">
            <a class="brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                <span>K.M.K.K.M</span>
                <small>Store + Portal do Cliente</small>
            </a>
            <nav class="main-nav">
                <a asp-area="" asp-controller="Home" asp-action="Index">Empresa</a>
                <a asp-area="" asp-controller="Home" asp-action="Store">Store</a>
                <a asp-area="Client" asp-controller="Dashboard" asp-action="Index">Area do Cliente</a>
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="nav-user">@User.Identity.Name</span>
                    <form method="post" asp-controller="Account" asp-action="Logout" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="nav-button">Sair</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Entrar</a>
                }
            </nav>
        </div>
    </header>
    <main class="container-fluid shell-width">
        @RenderBody()
    </main>
    <footer class="footer-shell">
        <div class="container-fluid shell-width">
            <strong>K.M.K.K.M Portal do Cliente</strong>
            <span>Base inicial do ecossistema da startup em ASP.NET Core + C# + PostgreSQL.</span>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
