@model KMKKM.PortalClient.Application.Contracts.Admin.AdminWorkspaceViewModel
@{
    ViewData["Title"] = "Admin";
    bool canManageSystemUpdate = ViewBag.CanManageSystemUpdate is true;
}

<section class="dashboard-hero">
    <div>
        <span class="eyebrow">Admin</span>
        <h1>@Model.WelcomeTitle</h1>
        <p class="hero-description">Base operacional para dono, vendas e suporte trabalharem no mesmo ecossistema com perfis separados.</p>
    </div>
    <span class="tag">@Model.OpenClawStatus.Mode</span>
</section>

@if (canManageSystemUpdate)
{
    <section class="section-block">
        <div class="section-heading">
            <h2>Atualizacao do sistema</h2>
            <span>@Model.SystemUpdateStatus.Channel</span>
        </div>
        <article class="workspace-card">
            @if (Model.SystemUpdateStatus.HasPendingUpdate)
            {
                <span class="tag tag-alert">Atualizacao pendente</span>
            }
            else
            {
                <span class="tag">Sem pendencias</span>
            }

            <h3>Versao atual: @Model.SystemUpdateStatus.CurrentVersion</h3>
            <p>@Model.SystemUpdateStatus.Summary</p>
            <ul>
                <li>Versao alvo: @Model.SystemUpdateStatus.TargetVersion</li>
                <li>Aprovacao do Admin: @(Model.SystemUpdateStatus.RequiresAdminApproval ? "Obrigatoria" : "Nao obrigatoria")</li>
                <li>Servico de update: @(Model.SystemUpdateStatus.IsAvailable ? "Disponivel" : "Indisponivel")</li>
            </ul>
        </article>
    </section>
}

<section class="section-block">
    <div class="section-heading">
        <h2>Indicadores comerciais</h2>
        <span>CRM, recorrencia e conversao</span>
    </div>
    <div class="stats-grid">
        @foreach (var metric in Model.SalesMetrics)
        {
            <article class="status-card">
                <h3>@metric.Label</h3>
                <strong>@metric.Value</strong>
                <p>@metric.Context</p>
            </article>
        }
    </div>
</section>

<section class="section-block">
    <div class="section-heading">
        <h2>Indicadores de suporte</h2>
        <span>Chamados, atendimento e operacao</span>
    </div>
    <div class="stats-grid">
        @foreach (var metric in Model.SupportMetrics)
        {
            <article class="status-card">
                <h3>@metric.Label</h3>
                <strong>@metric.Value</strong>
                <p>@metric.Context</p>
            </article>
        }
    </div>
</section>

<section class="workspace-grid">
    <article class="workspace-card">
        <h2>Filas prioritarias</h2>
        <ul>
            @foreach (var queue in Model.PriorityQueues)
            {
                <li>@queue</li>
            }
        </ul>
    </article>
    <article class="workspace-card">
        <h2>OpenClaw</h2>
        <p>@Model.OpenClawStatus.Summary</p>
        <ul>
            @foreach (var step in Model.OpenClawStatus.NextSteps)
            {
                <li>@step</li>
            }
        </ul>
    </article>
</section>
