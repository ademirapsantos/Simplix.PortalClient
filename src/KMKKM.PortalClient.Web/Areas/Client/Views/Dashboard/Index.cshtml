@model KMKKM.PortalClient.Application.Contracts.Client.ClientWorkspaceViewModel
@{
    ViewData["Title"] = "Area do Cliente";
    ViewData["UseWideShell"] = true;
    ViewData["ClientSection"] = "account";
}

<div class="client-account-shell">
    <partial name="~/Areas/Client/Views/Shared/_AccountSidebar.cshtml" model="Model" />

    <div class="client-account-content">
        <section class="client-account-header" id="conta">
            <div>
                <p class="client-account-kicker">Conta</p>
                <h1>@Model.CustomerName</h1>
            </div>

            <div class="client-account-actions">
                <article class="client-summary-card">
                    <span class="client-summary-icon">P</span>
                    <div>
                        <strong>Plano @Model.CurrentPlan</strong>
                        <p>Renovacao em @Model.NextRenewalDate.ToString("dd/MM/yyyy")</p>
                    </div>
                </article>

                <article class="client-summary-card">
                    <span class="client-summary-icon">S</span>
                    <div>
                        <strong>Seguranca da conta</strong>
                        <p>Altere senha e revise os acessos liberados.</p>
                    </div>
                </article>
            </div>
        </section>

        <section class="client-metric-strip" aria-label="Indicadores da conta">
            @foreach (var metric in Model.Metrics)
            {
                <article class="client-metric-card">
                    <span>@metric.Label</span>
                    <strong>@metric.Value</strong>
                    <p>@metric.Context</p>
                </article>
            }
        </section>

        <section class="client-accordion-stack">
            <details class="client-account-panel client-account-panel-featured" id="assinaturas" open>
                <summary>
                    <div class="client-panel-heading">
                        <div>
                            <strong>Assinaturas</strong>
                            <p>Produtos contratados, plano vigente e renovacoes.</p>
                        </div>
                        <span class="client-panel-status">Plano @Model.CurrentPlan</span>
                    </div>
                </summary>
                <div class="client-panel-body">
                    <div class="client-licenses-grid">
                        @foreach (var license in Model.Licenses)
                        {
                            <article class="client-license-card">
                                <div class="ticket-card-header">
                                    <span class="product-badge">@license.Status</span>
                                    <span class="client-inline-label">Plano @license.PlanName</span>
                                </div>
                                <h3>@license.ProductName</h3>
                                <p>Contrato ativo dentro da operacao do cliente.</p>
                                <div class="client-license-meta">
                                    <div>
                                        <span>Renovacao</span>
                                        <strong>@license.ExpiresOn.ToString("dd/MM/yyyy")</strong>
                                    </div>
                                    <div>
                                        <span>Status</span>
                                        <strong>@license.Status</strong>
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </details>

            <details class="client-account-panel" id="financeiro">
                <summary>
                    <div class="client-panel-heading">
                        <div>
                            <strong>Financeiro</strong>
                            <p>Mensalidades, implantacoes, pagamentos e conciliacao.</p>
                        </div>
                        <span class="client-panel-status">@Model.FinancialHistory.Count lancamentos</span>
                    </div>
                </summary>
                <div class="client-panel-body">
                    <div class="financial-history-grid">
                        @foreach (var entry in Model.FinancialHistory)
                        {
                            <article class="workspace-card financial-entry-card">
                                <div class="ticket-card-header">
                                    <span class="tag">@entry.ReferenceNumber</span>
                                    <span class="ticket-chip @($"financial-status-{entry.Status.ToLowerInvariant().Replace(" ", "-")}")">@entry.Status</span>
                                </div>
                                <h3>@entry.Description</h3>
                                <p>@entry.ProductName</p>
                                <div class="financial-entry-meta">
                                    <span>Vencimento</span>
                                    <strong>@entry.DueOn.ToString("dd/MM/yyyy")</strong>
                                </div>
                                <div class="financial-entry-meta">
                                    <span>Pagamento</span>
                                    <strong>@(entry.PaidOn?.ToString("dd/MM/yyyy") ?? "Aguardando baixa")</strong>
                                </div>
                                <div class="financial-entry-meta">
                                    <span>Forma</span>
                                    <strong>@entry.PaymentMethod</strong>
                                </div>
                                <div class="card-footer">
                                    <span>Valor</span>
                                    <strong>@entry.Amount.ToString("C")</strong>
                                </div>
                            </article>
                        }
                    </div>
                </div>
            </details>

            <details class="client-account-panel" id="acessos">
                <summary>
                    <div class="client-panel-heading">
                        <div>
                            <strong>Acessos aos produtos</strong>
                            <p>Ambientes liberados e atalhos para os sistemas contratados.</p>
                        </div>
                        <span class="client-panel-status">@Model.ProductAccesses.Count ambientes</span>
                    </div>
                </summary>
                <div class="client-panel-body">
                    <div class="card-grid product-access-grid">
                        @foreach (var access in Model.ProductAccesses)
                        {
                            <article class="workspace-card product-access-card">
                                <div class="ticket-card-header">
                                    <span class="tag">@access.ProductName</span>
                                    <span class="ticket-chip @($"access-status-{access.AccessStatus.ToLowerInvariant().Replace(" ", "-")}")">@access.AccessStatus</span>
                                </div>
                                <h3>@access.EnvironmentName</h3>
                                <p>@access.CredentialHint</p>
                                <div class="financial-entry-meta">
                                    <span>Entrada</span>
                                    <strong>@access.AccessLabel</strong>
                                </div>
                                <a class="btn btn-outline-light" href="@access.AccessUrl" target="_blank" rel="noreferrer">Abrir ambiente</a>
                            </article>
                        }
                    </div>
                </div>
            </details>

            <details class="client-account-panel" id="chamados">
                <summary>
                    <div class="client-panel-heading">
                        <div>
                            <strong>Chamados recentes</strong>
                            <p>Ultimas demandas abertas pela operacao do cliente.</p>
                        </div>
                        <span class="client-panel-status">@Model.RecentTickets.Count chamados</span>
                    </div>
                </summary>
                <div class="client-panel-body">
                    <div class="client-panel-toolbar">
                        <a asp-area="Client" asp-controller="SupportTickets" asp-action="Index">Abrir quadro completo</a>
                    </div>
                    <div class="card-grid client-ticket-grid">
                        @foreach (var ticket in Model.RecentTickets)
                        {
                            <article class="workspace-card ticket-card">
                                <div class="ticket-card-header">
                                    <span class="tag">@ticket.Category</span>
                                    <span class="ticket-status">@ticket.Status</span>
                                </div>
                                <h3>@ticket.Subject</h3>
                                <p class="ticket-date">Criado em @ticket.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            </article>
                        }
                    </div>
                </div>
            </details>

            <details class="client-account-panel" id="acoes">
                <summary>
                    <div class="client-panel-heading">
                        <div>
                            <strong>Proximas acoes</strong>
                            <p>Prioridades operacionais e oportunidades comerciais.</p>
                        </div>
                        <span class="client-panel-status">@Model.RecommendedActions.Count focos</span>
                    </div>
                </summary>
                <div class="client-panel-body client-dual-panel">
                    <article class="workspace-card workspace-card-featured">
                        <div class="section-heading section-heading-compact">
                            <h2>Foco imediato</h2>
                            <span>Operacao</span>
                        </div>
                        <ul class="action-list">
                            @foreach (var actionItem in Model.RecommendedActions)
                            {
                                <li>@actionItem</li>
                            }
                        </ul>
                    </article>

                    <article class="workspace-card">
                        <div class="section-heading section-heading-compact">
                            <h2>Upgrades sugeridos</h2>
                            <span>Comercial</span>
                        </div>
                        <ul class="action-list">
                            @foreach (var upgrade in Model.AvailableUpgrades)
                            {
                                <li>@upgrade</li>
                            }
                        </ul>
                    </article>
                </div>
            </details>
        </section>
    </div>
</div>
